VVN_ENVIRONMENT=staging
VVN_EXPECTED_SUPABASE_PROJECT_REF=msfrkqfvdhyjnktwuhzd
# Configurar SOLO con el entorno de pruebas que se quiera usar.
# No se copiaron credenciales de la web. Este archivo no se carga automáticamente.
NEXT_PUBLIC_SUPABASE_URL=https://msfrkqfvdhyjnktwuhzd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-test-publishable-key
# UUID de VVN en ESTE entorno. Solo servidor; no se acepta desde peticiones.
VVN_BRAND_ID=replace-with-vvn-brand-uuid
# Cuenta técnica de VVN registrada en brand_operators. No usar service role.
BRAND_OPERATOR_EMAIL=replace-with-test-operator-email
BRAND_OPERATOR_PASSWORD=replace-with-test-operator-password
# Solo scripts verify:test-db y verify:test-api; nunca seleccionan la marca de la API.
TEST_OTHER_BRAND_ID=replace-with-other-test-brand-uuid
TEST_OTHER_OPERATOR_EMAIL=replace-with-other-test-operator-email
TEST_OTHER_OPERATOR_PASSWORD=replace-with-other-test-operator-password
# Debe coincidir con el RATING_SALT efectivo de la web al compartir DB.
# En la web anterior puede caer a ADMIN_SECRET; NO hay login admin en esta API.
RATING_SALT=replace-with-shared-rating-salt-for-the-selected-environment
NEXT_PUBLIC_VVN_SITE_URL=https://vivevallenorte.com
NEXT_PUBLIC_ADMIN_WHATSAPP=
MOBILE_MIN_VERSION_IOS=1.0.0
MOBILE_MIN_VERSION_ANDROID=1.0.0
MOBILE_KILL_SWITCH=0
MOBILE_KILL_MESSAGE=
# Opcionales: Redis para rate limiting distribuido; Sentry para errores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
