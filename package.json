{
  "name": "vvn-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3123 --webpack",
    "build": "next build --webpack",
    "build:local": "node scripts/build-local.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3123",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:v1": "tsx scripts/check-v1-contract.ts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "verify:test-db": "node scripts/verify-test-supabase.mjs",
    "verify:test-api": "node scripts/verify-test-api.mjs",
    "postbuild": "node scripts/clean-standalone-env.mjs",
    "dev:staging": "node scripts/run-environment.mjs staging dev",
    "build:staging": "node scripts/run-environment.mjs staging build",
    "start:staging": "node scripts/run-environment.mjs staging start",
    "dev:production": "node scripts/run-environment.mjs production dev",
    "build:production": "node scripts/run-environment.mjs production build",
    "start:production": "node scripts/run-environment.mjs production start"
  },
  "dependencies": {
    "@sentry/nextjs": "11.1.0",
    "@supabase/supabase-js": "2.101.1",
    "@upstash/redis": "1.38.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "vitest": "3.2.7"
  }
}
